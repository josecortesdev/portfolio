---
import { Image } from 'astro:assets';
import VideoPreview from '../components/VideoPreview.astro';
import portrait from '../../public/photo.jpg';
import Layout from '../layouts/Layout.astro';
import { profile, nexosend, projects } from '../data/portfolio';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<Layout>
  <header class="site-header wrap">
    <a class="wordmark" href={`${base}/`} aria-label="José Cortés home">jc<span>.</span></a>
    <nav aria-label="Main navigation">
      <a href="#work">Projects</a>
      <a href="#about">Experience</a>
      <a class="nav-contact" href="#contact">Contact</a>
    </nav>
  </header>
  <main id="main">
    <section class="hero wrap" aria-labelledby="intro-title">
      <div class="hero-copy">
        <p class="intro-name">
          <span class="portrait">
            <Image src={portrait} alt="" width={820} format="webp" loading="eager" />
          </span>
          <span class="intro-details">
            <span>{profile.name}</span>
            <span class="eyebrow availability"><span class="status-dot" aria-hidden="true"></span>{profile.availability}</span>
          </span>
        </p>
        <h1 id="intro-title">PHP / <span>Laravel</span> Developer</h1>
        <p class="hero-intro">{profile.intro}</p>
        <div class="hero-actions">
          <a class="button button-dark" href={`${base}/work/nexosend/`}>View the Nexosend case study <span aria-hidden="true">→</span></a>
          {profile.resume && <a class="button button-outline" href={`${base}/${profile.resume}`} target="_blank" rel="noopener noreferrer">View CV (PDF) <span class="sr-only">(opens in a new tab)</span></a>}
          {profile.linkedin && <a class="text-link" href={profile.linkedin} target="_blank" rel="noopener noreferrer">LinkedIn <span class="sr-only">(opens in a new tab)</span></a>}
          <a class="text-link" href={`mailto:${profile.email}`}>Get in touch <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>

    <section id="work" class="work-section wrap" aria-labelledby="work-title">
      <div class="section-heading"><h2 id="work-title">Featured project</h2></div>
      <article class="featured-project">
        <div class="project-copy">
          <p class="eyebrow">SMS platform & REST API</p>
          <h3>{nexosend.name}<span class="project-dot">.</span></h3>
          <p class="project-lead">{nexosend.description}</p>
          <div class="project-links"><a class="button button-dark" href={`${base}/work/nexosend/`}>Read the case study <span aria-hidden="true">↗</span></a><a class="text-link" href={nexosend.url} target="_blank" rel="noopener noreferrer">Visit live app <span class="sr-only">(opens in a new tab)</span><span aria-hidden="true">↗</span></a></div>
        </div>
        <a class="project-preview" href={`${base}/work/nexosend/`} aria-label="View the Nexosend case study">
          <img src={`${base}/nexosend-statistics.png`} width="1186" height="706" loading="lazy" alt="Nexosend dashboard showing SMS counts by status and a chart of recent activity" />
        </a>
      </article>
      <div class="feature-notes">{nexosend.features.map(feature => <div><h3>{feature.title}</h3><p>{feature.text}</p></div>)}</div>
    </section>

    <section class="earlier-section wrap" aria-labelledby="earlier-title">
      <div class="section-heading"><h2 id="earlier-title">More projects: APIs &amp; web applications</h2></div>
      <div class="project-list">{projects.map(project => <details class="project-row"><summary><span class="project-year">{project.year}</span><span class="project-summary"><span class="project-title">{project.name}<small>{project.kind}</small></span><span class="summary-text">{project.summary}</span></span><span class="expand-icon" aria-hidden="true">+</span></summary><div class="project-details">
        {project.videoId && <VideoPreview videoId={project.videoId} title={project.name} label={project.videoLabel} />}
        {project.videoFile && <figure class="project-demo">
          <figcaption>{project.videoLabel}</figcaption>
          <video controls playsinline preload="none" aria-label={project.videoLabel} src={project.videoFile}></video>
          <a class="text-link" href={project.videoFile} target="_blank" rel="noopener noreferrer">Open video in a new tab ↗</a>
        </figure>}
        <div class="tags">{project.tags.map(tag => <span>{tag}</span>)}</div><p>{project.details}</p><p class="takeaway">{project.takeaway}</p><div class="project-resources">{project.code && <a class="text-link" href={project.code} target="_blank" rel="noopener noreferrer">{project.codeLabel ?? 'View source on GitHub'} <span class="sr-only">(opens in a new tab)</span><span aria-hidden="true">↗</span></a>}
        {project.videoId && <a class="text-link" href={`https://www.youtube.com/watch?v=${project.videoId}`} target="_blank" rel="noopener noreferrer">Open on YouTube <span class="sr-only">(opens in a new tab)</span>↗</a>}
        {project.links?.map(link => <a class="text-link" href={link.url} target="_blank" rel="noopener noreferrer">{link.label}<span class="sr-only">(opens in a new tab)</span><span aria-hidden="true">↗</span></a>)}
      </div></div></details>)}</div>
    </section>

    <section id="about" class="about-section wrap" aria-labelledby="about-title">
      <div>
        <h2 id="about-title">Professional experience</h2>
        <p>4+ years in web development · Fluent in English</p>
        <div class="skill-groups">
          <h3>Backend &amp; APIs</h3>
          <p>PHP · Laravel · MySQL · REST APIs</p>
          <h3>Frontend</h3>
          <p>Vue.js · JavaScript · Angular · jQuery</p>
          <h3>Testing &amp; tooling</h3>
          <p>PHPUnit · GitHub Actions · Docker</p>
        </div>
        <div class="about-links">
          <a class="text-link" href={profile.github} target="_blank" rel="noopener noreferrer">GitHub <span class="sr-only">(opens in a new tab)</span><span aria-hidden="true">↗</span></a>
          {profile.linkedin && <a class="text-link" href={profile.linkedin}>LinkedIn ↗</a>}
          {profile.resume && <a class="button button-outline" href={`${base}/${profile.resume}`} target="_blank" rel="noopener noreferrer">View CV (PDF) <span class="sr-only">(opens in a new tab)</span></a>}
        </div>
      </div>
      <div class="about-copy">
        <h3>Analyst Developer · Tragsatec</h3>
        <p class="experience-dates"><time datetime="2024-10">Oct 2024</time> – Present</p>
        <p>{profile.currentWork}</p>
        <h3>Senior Developer · Visual Data Intelligence</h3>
        <p class="experience-dates"><time datetime="2023-10">Oct 2023</time> – <time datetime="2024-10">Oct 2024</time></p>
        <p>{profile.previousWork}</p>
        <h3>Junior Developer · Adalid</h3>
        <p class="experience-dates"><time datetime="2021-12">Dec 2021</time> – <time datetime="2023-10">Oct 2023</time></p>
        <p>{profile.firstWork}</p>
      </div>
    </section>

    <section id="contact" class="contact-section" aria-labelledby="contact-title">
      <div class="wrap contact-inner">
        <h2 id="contact-title">Looking for a Laravel developer<span>?</span></h2>
        <div class="contact-bottom">
          <p>I’m open to remote contracts. I’d love to hear about your team and what you’re working on.</p>
          <p>Available for North American working hours and similar time zones.</p>
          <a class="contact-email" href={`mailto:${profile.email}`}>{profile.email} <span aria-hidden="true">↗</span></a>
        </div>
      </div>
    </section>
  </main>
  <footer class="site-footer wrap">
    <span>© {new Date().getFullYear()} José Cortés</span>
    <a href="#main">Back to top ↑</a>
  </footer>
</Layout>
